{
  // markdownlint-cli2 configuration for par-osm-rust.
  //
  // The CI docs-lint job (.github/workflows/ci.yml) runs markdownlint-cli2 over
  // README.md and docs/. Only rules that legitimately conflict with the
  // project's prose style are relaxed; every other rule stays at its default.
  //
  // MD013 (line-length): disabled because README tables/prose and the Mermaid
  //   diagrams in docs/ARCHITECTURE.md routinely exceed 80 columns, and the
  //   project's own DOCUMENTATION_STYLE_GUIDE does not impose a hard line
  //   limit. Rewrapping every paragraph and diagram would hurt readability.
  // MD024 (no-duplicate-heading): disabled because docs/DOCUMENTATION_STYLE_GUIDE.md
  //   legitimately repeats heading text inside its Table of Contents and in
  //   its "Prefer This / Avoid This" example pairs, and the README's
  //   subsection names overlap conceptually across concerns.
  // MD028 (no-blanks-blockquote): disabled because docs/DOCUMENTATION_STYLE_GUIDE.md
  //   uses multi-paragraph blockquotes (with intentional blank separator lines)
  //   in its "Prefer This / Avoid This" guidance blocks.
  "config": {
    "MD013": false,
    "MD024": false,
    "MD028": false
  },
  // Never lint generated/build artifacts even if a future glob sweep picks
  // them up. The CI job already targets README.md and docs/, so these are
  // purely defensive.
  "ignores": [
    "target/",
    "**/target/",
    "Cargo.lock",
    "**/*.rs",
    ".claude/"
  ]
}
