<?xml version="1.0" encoding="UTF-8"?>
<!--
  PBF/XML parity fixture for ENH-002 (tests/integration.rs).

  Hand-written so every classification branch is exercised once:
    - 5 plain (untagged) nodes used by the two ways
    - 1 POI node        (amenity=cafe + name)
    - 1 address node    (addr:housenumber + addr:street)
    - 1 tree node       (natural=tree)
    - 1 open way        (highway=residential)
    - 1 closed way      (building=yes; first ref == last ref)
    - 1 multipolygon relation referencing the building way

  The <bounds> element is set to the EXACT lat/lon extrema of the nodes, so the
  XML parser (which honors an explicit <bounds>) and the PBF parser (which
  computes bounds from node extrema only — there is no <bounds> concept on the
  PBF read path) agree on the dataset bbox. Coordinates use ≤6 decimal places,
  which round-trip exactly through PBF's nano-degree (1e-9) integer encoding.

  The .osm.pbf twin of this file is generated by osmium-tool; see README.md in
  this directory for the exact command and the osmium version the committed
  binary was produced with.
-->
<osm version="0.6" generator="par-osm-rust ENH-002 fixture">
  <bounds minlat="51.500" minlon="-0.100" maxlat="51.515" maxlon="-0.090"/>

  <!-- Plain nodes used by the ways -->
  <node id="1" lat="51.500" lon="-0.100" version="1"/>
  <node id="2" lat="51.500" lon="-0.090" version="1"/>
  <node id="3" lat="51.510" lon="-0.100" version="1"/>
  <node id="4" lat="51.510" lon="-0.090" version="1"/>
  <node id="5" lat="51.515" lon="-0.095" version="1"/>

  <!-- POI node: amenity + name (non-ASCII pins UTF-8 tag round-trip) -->
  <node id="100" lat="51.505" lon="-0.095" version="1">
    <tag k="amenity" v="cafe"/>
    <tag k="name" v="Parity Café"/>
  </node>

  <!-- Address node -->
  <node id="101" lat="51.506" lon="-0.096" version="1">
    <tag k="addr:housenumber" v="42"/>
    <tag k="addr:street" v="Main St"/>
  </node>

  <!-- Tree node -->
  <node id="102" lat="51.507" lon="-0.094" version="1">
    <tag k="natural" v="tree"/>
  </node>

  <!-- Open way: highway -->
  <way id="10" version="1">
    <nd ref="1"/>
    <nd ref="2"/>
    <tag k="highway" v="residential"/>
    <tag k="name" v="Parity Street"/>
  </way>

  <!-- Closed way: building (first ref == last ref) -->
  <way id="20" version="1">
    <nd ref="3"/>
    <nd ref="4"/>
    <nd ref="5"/>
    <nd ref="3"/>
    <tag k="building" v="yes"/>
    <tag k="name" v="Parity Building"/>
  </way>

  <!-- Multipolygon relation referencing the building way -->
  <relation id="200" version="1">
    <member type="way" ref="20" role="outer"/>
    <tag k="type" v="multipolygon"/>
    <tag k="landuse" v="park"/>
    <tag k="name" v="Parity Park"/>
  </relation>
</osm>
